# Example only. Load explicitly with: python -m food_crag.server --env-file .env
APP_HOST=127.0.0.1
APP_PORT=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=20
# Optional. e.g. gemini-embedding-001; then build vectors once with:
#   python -m food_crag.embedding --env-file .env
# Empty, missing or stale cache = TF-IDF only.
EMBEDDING_MODEL=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# true = enable the local testing entry /api/chat; docker-compose.yml sets false (public mode).
CHAT_API_ENABLED=true
# Item 12 (optional): Google Places shops, collected locally and never committed.
#   python -m food_crag.collect_places fetch --env-file .env   # writes data/places_review.csv
#   python -m food_crag.collect_places build                   # writes data/restaurants_google.json
GOOGLE_MAPS_API_KEY=
# Set to data/restaurants_google.json to load those shops; empty = the 32 menu-checked shops only.
GOOGLE_DATA_FILE=
